{
  "name": "desk365-mcp",
  "version": "1.0.0",
  "description": "MCP server for the Desk365 helpdesk API, generated from its OpenAPI spec",
  "type": "module",
  "bin": {
    "desk365-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "list-tools": "node dist/index.js --list-tools"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
